# Set these in your shell. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ATLAS_PORT=8000
ATLAS_AGENT_PROVIDER=openai
# For a Lovable Cloud / Supabase backend function or another agent service:
ATLAS_AGENT_ENDPOINT=
ATLAS_AGENT_TOKEN=
ATLAS_AGENT_ALLOWED_HOSTS=
# Bright Data is an optional retrieval tool; requires a Web Unlocker zone.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_ALLOWED_HOSTS=rarediseases.org,globalgenes.org,www.orpha.net,rarediseases.info.nih.gov
